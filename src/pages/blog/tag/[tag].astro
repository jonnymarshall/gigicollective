---
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate } from '../../../lib/date';
import { slugify } from '../../../lib/slug';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';

type Post = CollectionEntry<'posts'>;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = new Map<string, { label: string; posts: Post[] }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugify(tag);
      if (!tags.has(slug)) tags.set(slug, { label: tag, posts: [] });
      tags.get(slug)!.posts.push(post);
    }
  }

  return [...tags.entries()].map(([slug, { label, posts }]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { label, posts } = Astro.props;
---

<BaseLayout title={`Tagged ${label}`} description={`Posts tagged ${label}.`} overlayHeader>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Tag</p>
      <h1 class="display">{label}</h1>
    </div>
  </header>

  <section class="band band--bg" id="tag-index">
    <div class="wrap">
      <div class="grid">
        {posts.map((post) => (
          <PostCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            excerpt={post.data.description}
            image={post.data.heroImage}
            meta={formatDate(post.data.pubDate)}
          />
        ))}
      </div>
      <p style="margin-top:3rem"><a class="button button--ghost" href="/blog">All posts</a></p>
    </div>
  </section>
</BaseLayout>
