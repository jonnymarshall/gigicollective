---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage || undefined}
  article
  overlayHeader
>
  <article id={`post-${post.id}`}>
    <header class="page-head">
      <div class="wrap">
        <p class="eyebrow"><FormattedDate date={post.data.pubDate} /></p>
        <h1 class="display" style="max-width:20ch">{post.data.title}</h1>
        {post.data.description && <p class="lead" style="margin-top:1.5rem">{post.data.description}</p>}
      </div>
    </header>

    {post.data.heroImage && (
      <img src={post.data.heroImage} alt="" style="width:100%;max-height:62vh;object-fit:cover" />
    )}

    <div class="band band--bg">
      <div class="wrap">
        <div class="prose"><Content /></div>

        {post.data.tags.length > 0 && (
          <ul class="tag-list" style="margin-top:3.5rem">
            {post.data.tags.map((tag) => <li><a href={`/blog/tag/${slugify(tag)}`}>{tag}</a></li>)}
          </ul>
        )}

        {post.data.updatedDate && (
          <p style="margin-top:2rem;font-size:0.8rem;color:var(--c-muted)">
            Updated <FormattedDate date={post.data.updatedDate} />
          </p>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
