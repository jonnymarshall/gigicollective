---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Blocks from '../components/Blocks.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;

// A page is built from blocks. Anything typed into the markdown body still
// renders underneath them, so older pages written before blocks existed keep
// working rather than silently going blank.
const { Content } = await render(page);
const hasBlocks = page.data.blocks.length > 0;
---

<BaseLayout title={page.data.title} description={page.data.description} image={page.data.heroImage || undefined}>
  <article id={`page-${page.id}`}>
    <header class="wrap" style="margin-bottom:2.5rem">
      <h1>{page.data.title}</h1>
      {page.data.description && <p class="lead">{page.data.description}</p>}
    </header>

    {page.data.heroImage && (
      <div class="wrap">
        <img class="hero__image" src={page.data.heroImage} alt="" style="margin-bottom:2rem" />
      </div>
    )}

    <Blocks blocks={page.data.blocks} />

    {!hasBlocks && (
      <div class="wrap"><div class="prose"><Content /></div></div>
    )}
  </article>
</BaseLayout>
