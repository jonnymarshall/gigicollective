---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Blocks from '../components/Blocks.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;

// Anything typed into the markdown body still renders below the sections, so
// pages written before sections existed keep working rather than going blank.
const { Content } = await render(page);
const hasBlocks = page.data.blocks.length > 0;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  image={page.data.heroImage || undefined}
  overlayHeader
>
  <article id={`page-${page.id}`}>
    <header class="page-head">
      <div class="wrap">
        <h1 class="display">{page.data.title}</h1>
        {page.data.description && <p class="lead" style="margin-top:1.5rem">{page.data.description}</p>}
      </div>
    </header>

    {page.data.heroImage && (
      <img src={page.data.heroImage} alt="" style="width:100%;max-height:60vh;object-fit:cover" />
    )}

    <Blocks blocks={page.data.blocks} />

    {!hasBlocks && (
      <div class="band band--bg"><div class="wrap"><div class="prose"><Content /></div></div></div>
    )}
  </article>
</BaseLayout>
