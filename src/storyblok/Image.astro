---
import { storyblokEditable } from '@storyblok/astro';
import type { SbBlokData } from '@storyblok/astro';
import { blockClasses, assetUrl, assetAlt, ratioClass } from '../lib/blok-style';

interface Props { blok: SbBlokData }
const { blok } = Astro.props;
const image = assetUrl(blok.image);
---
{image && (
  <section {...storyblokEditable(blok)} class={blockClasses(blok, 'block--image')}>
    <div class="wrap">
      <figure style="margin:0">
        <img
          class={ratioClass(blok.ratio)}
          src={image}
          alt={assetAlt(blok.image, String(blok.caption ?? ''))}
          loading="lazy"
          style="width:100%"
        />
        {blok.caption && (
          <figcaption style="font-size:0.78rem;color:var(--c-muted);margin-top:0.75rem">
            {blok.caption}
          </figcaption>
        )}
      </figure>
    </div>
  </section>
)}
