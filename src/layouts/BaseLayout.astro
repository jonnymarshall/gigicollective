---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site-data';
import { themeVariables } from '../lib/theme';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  /** True when the page opens with a full-bleed hero the header sits on top of. */
  overlayHeader?: boolean;
}

const { title, description, image, article = false, overlayHeader = false } = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : `${site.title} | ${site.tagline}`;
const pageDescription = description || site.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = image ? new URL(image, Astro.site ?? Astro.url.origin) : undefined;

// Set PUBLIC_NOINDEX=true on a staging deploy so Google never indexes it and
// competes with the real site. Leave it unset in production.
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
---

<!doctype html>
<html lang="en" style={themeVariables()}>
  <head>
    <meta charset="utf-8" />

    <!-- Emits the @font-face rules and defines --font-serif / --font-sans.
         Without these the site silently falls back to Georgia and Arial. -->
    <Font
      cssVariable="--font-serif"
      preload={[{ weight: 300, style: 'normal', subset: 'latin' }, { weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <Font
      cssVariable="--font-sans"
      preload={[{ weight: 300, style: 'normal', subset: 'latin' }, { weight: 400, style: 'normal', subset: 'latin' }]}
    />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <Header overlay={overlayHeader} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
