---
interface Props { eyebrow?: string; quote?: string; attribution?: string; role?: string; background?: string }
const { eyebrow, quote, attribution, role, background = 'tint' } = Astro.props;
---
{quote && (
  <section class={`band band--${background} block--quote`}>
    <div class="wrap">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <figure class="quote">
        <span class="quote__mark" aria-hidden="true">&ldquo;</span>
        <blockquote>{quote}</blockquote>
        {attribution && (
          <figcaption>
            {attribution}{role && <><br />{role}</>}
          </figcaption>
        )}
      </figure>
    </div>
  </section>
)}
