---
interface Props { image?: string; caption?: string; width?: string; background?: string }
const { image, caption, width = 'wide', background = 'bg' } = Astro.props;
---
{image && (
  <section class={`band band--${background} block--image`}>
    <div class={width === 'full' ? '' : 'wrap'}>
      <figure style="margin:0">
        <img src={image} alt={caption || ''} loading="lazy"
             style={width === 'full' ? 'width:100%;max-height:70vh;object-fit:cover' : ''} />
        {caption && (
          <figcaption class="wrap" style="font-size:0.78rem;color:var(--c-muted);margin-top:0.75rem;padding-inline:0">
            {caption}
          </figcaption>
        )}
      </figure>
    </div>
  </section>
)}
