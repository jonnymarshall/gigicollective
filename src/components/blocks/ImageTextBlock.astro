---
import { renderMarkdown } from '../../lib/markdown';
interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  image?: string;
  imageSide?: string;
  linkLabel?: string;
  linkUrl?: string;
  background?: string;
}
const {
  eyebrow, heading, text, image, imageSide = 'right',
  linkLabel, linkUrl, background = 'bg',
} = Astro.props;
---
<section class={`band band--${background} block--imagetext`}>
  <div class="wrap">
    <!-- With no image there is nothing to sit beside, so fall back to one
         readable column rather than leaving half the row empty. -->
    <div class={image ? `split ${imageSide === 'left' ? 'split--flip' : ''}` : 'prose'}>
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h2>{heading}</h2>}
        {text && <div set:html={renderMarkdown(text)} />}
        {linkLabel && linkUrl && (
          <p style="margin-top:2rem"><a class="button button--ghost" href={linkUrl}>{linkLabel}</a></p>
        )}
      </div>
      {image && <img src={image} alt="" loading="lazy" />}
    </div>
  </div>
</section>
