---
import site from '../data/site.json';
---

<footer id="site-footer" class="site-footer">
  <div class="wrap site-footer__inner">
    <p id="site-footer-text">{site.footerText}</p>
    {(site.social?.length || site.email) && (
      <ul id="site-footer-links">
        {site.email && (
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        )}
        {site.social?.map((item) => (
          <li><a href={item.url} rel="me noopener" target="_blank">{item.label}</a></li>
        ))}
      </ul>
    )}
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: 2rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    align-items: center;
  }
  .site-footer p { margin: 0; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--color-muted); }
  a:hover { color: var(--color-accent); }
</style>
